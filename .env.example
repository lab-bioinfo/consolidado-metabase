# =============================================================================
# Plantilla de variables de entorno. Copie este archivo a `.env` y ajuste.
# `.env` NO se versiona (ver .gitignore). Los valores de abajo son de ejemplo
# para desarrollo local; reemplace por valores reales en producción.
# =============================================================================

# --- PostgreSQL (base de datos de la aplicación) ------------------------------
POSTGRES_DB=antimicrobianos
POSTGRES_USER=etl
POSTGRES_PASSWORD=etl_dev_password
# Puerto publicado en el host (dentro del contenedor siempre es 5432).
POSTGRES_PORT=5432

# --- Base de datos interna de Metabase (NO H2) --------------------------------
METABASE_DB_NAME=metabase
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=metabase_dev_password

# --- Puerto HTTP de Metabase --------------------------------------------------
MB_PORT=3000
